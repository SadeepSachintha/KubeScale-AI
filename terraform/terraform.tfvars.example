# Example variables for KubeScale AI AWS EKS deployment
aws_region       = "us-east-1"
environment      = "dev"
project_name     = "kubescale"
cluster_name     = "kubescale-ai-cluster"
cluster_version  = "1.30"

vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]

# Set to true for dev (single NAT saves ~$60/month), false for production multi-AZ NAT
single_nat_gateway   = true

# EKS Node Group Autoscaling Settings
node_group_instance_types = ["t3.xlarge"]
node_group_min_size       = 2
node_group_max_size       = 10
node_group_desired_size   = 3

model_storage_bucket_name = "kubescale-ai-model-repository"
k8s_namespace             = "kubescale"
inference_service_account = "kubescale-inference-sa"

tags = {
  Project     = "KubeScale-AI"
  ManagedBy   = "Terraform"
  Environment = "dev"
  Owner       = "PlatformEngineering"
}
