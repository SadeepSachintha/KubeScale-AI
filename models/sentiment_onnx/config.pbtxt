name: "sentiment_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 64

input [
  {
    name: "INPUT_0"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

output [
  {
    name: "OUTPUT_0"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]

# Enable Dynamic Batching to eliminate Head-of-Line Blocking and optimize throughput
dynamic_batching {
  preferred_batch_size: [ 4, 8, 16, 32, 64 ]
  max_queue_delay_microseconds: 5000
}

# Deploy 2 concurrent model instances per worker pod
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

# Version policy: serve latest version
version_policy: {
  latest: {
    num_versions: 1
  }
}
