name: "fraud_detection_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 128

input [
  {
    name: "INPUT_0"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

output [
  {
    name: "OUTPUT_0"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]

# High-throughput dynamic batching tailored for sub-millisecond fraud scoring
dynamic_batching {
  preferred_batch_size: [ 8, 16, 32, 64, 128 ]
  max_queue_delay_microseconds: 2000
}

# 2 worker threads in CPU pool for concurrent transaction scoring
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

# Serve the latest version
version_policy: {
  latest: {
    num_versions: 1
  }
}
